#!/bin/bash

# ============================================================================
# ContextArchitect Skills - Setup Script
# Configures Claude Desktop with all skills and three MCP servers (github, kie, mindcase)
# Works on macOS (Terminal) and Windows (Git Bash)
# ============================================================================

set -e

# Detect OS and set paths
if [[ "$OSTYPE" == "darwin"* ]]; then
    OS="mac"
    SKILLS_DIR="$HOME/.claude/skills/context-architect"
    CLAUDE_CONFIG_DIR="$HOME/Library/Application Support/Claude"
elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ -n "$WINDIR" ]]; then
    OS="windows"
    SKILLS_DIR="$USERPROFILE/.claude/skills/context-architect"
    CLAUDE_CONFIG_DIR="$APPDATA/Claude"
else
    OS="linux"
    SKILLS_DIR="$HOME/.claude/skills/context-architect"
    CLAUDE_CONFIG_DIR="$HOME/.config/Claude"
fi

CLAUDE_CONFIG_FILE="$CLAUDE_CONFIG_DIR/claude_desktop_config.json"

# Colors (disable on Windows if not supported)
if [[ "$OS" == "windows" ]] && ! echo -e "\033[0m" 2>/dev/null | grep -q "\[0m" 2>/dev/null; then
    RED='' GREEN='' YELLOW='' BLUE='' NC=''
else
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
fi

echo ""
echo -e "${BLUE}============================================================${NC}"
echo -e "${BLUE}  ContextArchitect - Claude Desktop Setup${NC}"
echo -e "${BLUE}============================================================${NC}"
echo ""
echo -e "  Detected OS: $OS"
echo ""

# -------------------------------------------------------
# Check prerequisites
# -------------------------------------------------------
echo -e "${YELLOW}Checking prerequisites...${NC}"

# Check for Claude Desktop
if [[ "$OS" == "mac" ]]; then
    if [ -d "/Applications/Claude.app" ]; then
        echo -e "  ${GREEN}OK${NC} Claude Desktop installed"
    else
        echo -e "  ${YELLOW}!${NC} Claude Desktop not found in /Applications."
        echo "    Download it from: https://claude.ai/download"
        echo "    Install it, then re-run this setup."
        exit 1
    fi
elif [[ "$OS" == "windows" ]]; then
    if [ -d "$LOCALAPPDATA/AnthropicClaude" ] || [ -d "$LOCALAPPDATA/Programs/claude-desktop" ] || command -v claude 2>/dev/null; then
        echo -e "  ${GREEN}OK${NC} Claude Desktop detected"
    else
        echo -e "  ${YELLOW}!${NC} Claude Desktop may not be installed."
        echo "    Download it from: https://claude.ai/download"
        echo "    If it IS installed, you can continue anyway."
    fi
fi

# Check for Node.js / npx (required for the GitHub and Kie MCPs)
if command -v npx &> /dev/null; then
    echo -e "  ${GREEN}OK${NC} Node.js / npx available"
else
    echo -e "${RED}ERROR: Node.js is not installed (npx not found).${NC}"
    echo ""
    echo "  Install Node.js first, then re-run this setup."
    echo ""
    if [[ "$OS" == "mac" ]]; then
        echo "  Option 1: brew install node"
        echo "  Option 2: Download from https://nodejs.org (LTS version)"
    else
        echo "  Download from https://nodejs.org (LTS version)"
        echo "  Make sure 'Add to PATH' is checked during installation."
        echo "  Then CLOSE and REOPEN Git Bash before re-running this setup."
    fi
    echo ""
    exit 1
fi

# Check for uv / uvx (required for the Mindcase MCP)
if command -v uvx &> /dev/null; then
    echo -e "  ${GREEN}OK${NC} uv / uvx available"
else
    echo -e "${RED}ERROR: uv is not installed (uvx not found).${NC}"
    echo ""
    echo "  Install uv, then CLOSE and REOPEN this terminal and re-run setup:"
    if [[ "$OS" == "mac" ]]; then
        echo "    curl -LsSf https://astral.sh/uv/install.sh | sh"
    elif [[ "$OS" == "windows" ]]; then
        echo "    In PowerShell (not Git Bash), run:"
        echo '    powershell -ExecutionPolicy ByPass -c "irm https://astral.sh/uv/install.ps1 | iex"'
    else
        echo "    curl -LsSf https://astral.sh/uv/install.sh | sh"
    fi
    echo ""
    exit 1
fi

echo ""

# -------------------------------------------------------
# Register skills
# -------------------------------------------------------
echo -e "${YELLOW}Registering skills...${NC}"
echo ""

SKILL_COUNT=0

for skill_dir in "$SKILLS_DIR"/*/; do
    if [ -f "$skill_dir/SKILL.md" ]; then
        skill_name=$(basename "$skill_dir")
        echo -e "  ${GREEN}OK${NC} $skill_name"
        SKILL_COUNT=$((SKILL_COUNT + 1))
    fi
done

if [ "$SKILL_COUNT" -eq 0 ]; then
    echo -e "  ${RED}No skills found. Make sure you cloned the repo correctly.${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}$SKILL_COUNT skills installed.${NC}"
echo ""

# -------------------------------------------------------
# Configure MCP servers in Claude Desktop config
# -------------------------------------------------------
echo -e "${YELLOW}Configuring MCP servers (github, kie, mindcase)...${NC}"

mkdir -p "$CLAUDE_CONFIG_DIR"

if [ -f "$CLAUDE_CONFIG_FILE" ]; then
    # Existing config: merge in any missing server without touching existing
    # ones (so a github block you already tokenised is preserved). Node is a
    # prerequisite (checked above), so we use it to edit the JSON safely.
    cp "$CLAUDE_CONFIG_FILE" "${CLAUDE_CONFIG_FILE}.backup"
    if node - "$CLAUDE_CONFIG_FILE" << 'NODEEOF'
const fs = require("fs");
const file = process.argv[process.argv.length - 1];
let cfg;
try {
  const text = fs.readFileSync(file, "utf8").trim();
  cfg = text ? JSON.parse(text) : {};
} catch (e) {
  console.error("  Could not parse existing config (invalid JSON).");
  process.exit(3);
}
if (typeof cfg !== "object" || cfg === null || Array.isArray(cfg)) { cfg = {}; }
if (typeof cfg.mcpServers !== "object" || cfg.mcpServers === null) { cfg.mcpServers = {}; }
const servers = {
  github:   { command: "npx", args: ["-y", "@modelcontextprotocol/server-github"], env: { GITHUB_PERSONAL_ACCESS_TOKEN: "YOUR_GITHUB_TOKEN_HERE" } },
  kie:      { command: "npx", args: ["-y", "@contextarchitect/kie-ai-mcp-server"], env: { KIE_AI_API_KEY: "YOUR_KIE_KEY_HERE" } },
  mindcase: { command: "uvx", args: ["ca-mindcase-mcp"], env: { MINDCASE_API_KEY: "YOUR_MINDCASE_KEY_HERE" } }
};
const added = [];
for (const [name, block] of Object.entries(servers)) {
  if (!cfg.mcpServers[name]) { cfg.mcpServers[name] = block; added.push(name); }
}
// Normalize a lingering placeholder from the previous installer to the current
// name, so the "replace the placeholders" step below covers it.
const gh = cfg.mcpServers.github;
if (gh && gh.env && gh.env.GITHUB_PERSONAL_ACCESS_TOKEN === "YOUR_GITHUB_PAT_HERE") {
  gh.env.GITHUB_PERSONAL_ACCESS_TOKEN = "YOUR_GITHUB_TOKEN_HERE";
}
fs.writeFileSync(file, JSON.stringify(cfg, null, 2) + "\n");
console.log(added.length ? ("  added: " + added.join(", ") + " (existing settings preserved)") : "  all three servers already present");
NODEEOF
    then
        echo -e "  ${GREEN}OK${NC} MCP servers configured (backup: ${CLAUDE_CONFIG_FILE}.backup)"
    else
        echo ""
        echo -e "  ${RED}Could not update your existing config (it is not valid JSON).${NC}"
        echo "  Your skills are installed, but the MCP servers were NOT added."
        echo "  Add them by hand: open INSTALLATION-GUIDE.md (Section 3), then restart Claude."
        echo "  Your original config is backed up at:"
        echo "    ${CLAUDE_CONFIG_FILE}.backup"
        echo ""
        exit 1
    fi
else
    cat > "$CLAUDE_CONFIG_FILE" << 'CONFIGEOF'
{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN_HERE"
      }
    },
    "kie": {
      "command": "npx",
      "args": ["-y", "@contextarchitect/kie-ai-mcp-server"],
      "env": {
        "KIE_AI_API_KEY": "YOUR_KIE_KEY_HERE"
      }
    },
    "mindcase": {
      "command": "uvx",
      "args": ["ca-mindcase-mcp"],
      "env": {
        "MINDCASE_API_KEY": "YOUR_MINDCASE_KEY_HERE"
      }
    }
  }
}
CONFIGEOF
    echo -e "  ${GREEN}OK${NC} github, kie, and mindcase configured with placeholder keys"
fi

echo ""

# -------------------------------------------------------
# Done
# -------------------------------------------------------
echo -e "${GREEN}============================================================${NC}"
echo -e "${GREEN}  Setup complete! $SKILL_COUNT skills installed.${NC}"
echo -e "${GREEN}============================================================${NC}"
echo ""
echo -e "${YELLOW}TWO LAST STEPS:${NC}"
echo ""
echo -e "  ${BLUE}1. Replace the three key placeholders:${NC}"
echo "     Open this file in any text editor:"
echo "     $CLAUDE_CONFIG_FILE"
echo ""
echo "     Replace any of these placeholders that appear in the file (keep the quotes):"
echo '       "YOUR_GITHUB_TOKEN_HERE"    -> your GitHub token'
echo '       "YOUR_KIE_KEY_HERE"         -> your Kie API key'
echo '       "YOUR_MINDCASE_KEY_HERE"    -> your Mindcase key (starts with mk_live_)'
echo "     Keys come from your ContextArchitect admin. Never share or commit them."
echo "     Save and close the file. See INSTALLATION-GUIDE.md for details."
echo ""
echo -e "  ${BLUE}2. Restart Claude Desktop:${NC}"
if [[ "$OS" == "mac" ]]; then
    echo "     Quit Claude Desktop completely (Command + Q)."
else
    echo "     Right-click the Claude icon in the system tray and Quit."
fi
echo "     Reopen it."
echo ""
echo -e "${GREEN}You're all set! The skills are available in every conversation.${NC}"
echo ""
